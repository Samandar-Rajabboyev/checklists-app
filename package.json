  },
  "dependencies": {
    "hono": "^4.13.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "wrangler": "^4.151.3"
  }
}
